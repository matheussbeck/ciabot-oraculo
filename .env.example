# ======================================
# CIABot Oráculo - Configuração
# ======================================

# Telegram Bot
# Obtenha seu token com @BotFather no Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# IDs de usuários autorizados (separados por vírgula)
# Obtenha seu ID com @userinfobot no Telegram
# Exemplo: 123456789,987654321
ALLOWED_USER_IDS=

# ======================================
# Configuração de IA
# ======================================

# Provedor de IA: anthropic ou openai
AI_PROVIDER=anthropic

# API Key da Anthropic (Claude)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Key da OpenAI (GPT)
# Obtenha em: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Modelo a usar
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# OpenAI: gpt-4-turbo, gpt-4, gpt-3.5-turbo
AI_MODEL=claude-3-5-sonnet-20241022

# ======================================
# Configuração de Confiança
# ======================================

# Threshold mínimo de confiança para responder (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.90
MIN_CONFIDENCE_TO_RESPOND=0.90

# ======================================
# Configuração de Safra
# ======================================

# Data de início da safra (formato: YYYY-MM-DD)
SAFRA_INICIO=2024-04-01

# ======================================
# Configuração de Logging
# ======================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ======================================
# Configurações Avançadas
# ======================================

# Modelo de embeddings (para futuras implementações)
EMBEDDING_MODEL=text-embedding-3-small

# Tamanho máximo de contexto em tokens
MAX_CONTEXT_TOKENS=100000

# Tamanho de chunk para processamento
CHUNK_SIZE=1000
